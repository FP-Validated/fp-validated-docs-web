# Required
GIT_TOKEN=ghp_replace_me

# Docs source
REPO_URL=https://github.com/FP-Validated/fp-validated-docs.git
REPO_BRANCH=main
GIT_USERNAME=x-access-token

# Sync cadence
SYNC_INTERVAL_SECONDS=300

# Direct docs service
DOCS_PORT=3000

# Optional local reverse proxy for docs.4pillars.info
EDGE_PORT=8081
